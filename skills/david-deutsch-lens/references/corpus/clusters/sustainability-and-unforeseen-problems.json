  "arguments": [{"id": "argument.future.unforeseen-defeats-fixed-plan.v1", "stance": "for", "summary": "A strategy optimized only for currently foreseeable disasters cannot address classes of future problems that have not yet been conceived.", "conclusions": ["claim.future.stasis-cannot-secure.v1"], "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.boi.2011.allen-lane", "locator": "chapter 17, Unsustainable, lines 4007-4177", "verification": "checked"}]}],
