  "problem": {"id": "problem.future.unforeseeable-threats.v1", "summary": "How can a civilization prepare for threats it cannot predict, and why is stasis not a durable safety strategy?", "origin": {"representation": "editorial-synthesis", "represents": "skill-editor"}, "source_refs": [], "routing": {"reasoning_jobs": ["evaluate-progress", "design-error-correction", "criticize"], "keywords": ["sustainability", "disaster", "future", "unforeseen", "risk", "stasis", "catastrophe", "resilience"], "structural_predicates": ["Safety is equated with preventing all foreseeable change.", "A fixed list of predicted disasters is treated as complete.", "Progress rhetoric is used to discard present risk controls."], "reject_if": ["no caveats", "ignore safety"], "diagnostic_questions": ["Which correction capabilities work across unpredicted problems?", "What present safeguards remain warranted?", "Does the strategy preserve knowledge creation or merely freeze current arrangements?"]}},
