  "problem": {
    "id": "problem.explanation.rival-flexible-stories.v1",
    "summary": "Predictions, descriptions, or multiple flexible stories fit what happened but do not provide a discriminating account of why.",
    "origin": {"representation": "editorial-synthesis", "represents": "skill-editor"},
    "source_refs": [],
    "routing": {
      "reasoning_jobs": ["define-concept", "evaluate-explanation", "diagnose", "criticize"],
