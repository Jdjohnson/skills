      "structural_predicates": ["Several incompatible stories fit the same observations.", "A proposed explanation can be patched after every outcome.", "A prediction is offered without an account of the underlying reality or mechanism."],
      "reject_if": ["mere preference", "only requesting a factual lookup"],
      "diagnostic_questions": ["Which details could change without changing the conclusion?", "What does this explanation rule out?", "What criticism would force replacement rather than another patch?"]
