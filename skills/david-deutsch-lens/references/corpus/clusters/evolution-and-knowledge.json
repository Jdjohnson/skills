  "problem": {"id": "problem.evolution.appearance-of-design.v1", "summary": "How can organisms embody purpose-specific knowledge without foresight, and how is that knowledge unlike human explanation?", "origin": {"representation": "editorial-synthesis", "represents": "skill-editor"}, "source_refs": [], "routing": {"reasoning_jobs": ["understand-worldview", "evaluate-explanation", "criticize"], "keywords": ["evolution", "adaptation", "gene", "replicator", "design", "selection", "knowledge"], "structural_predicates": ["Apparent design needs explanation without a designer.", "Evolution is described as optimizing a species or forecasting future needs.", "Biological and human knowledge are treated as identical."], "reject_if": ["organizational evolution metaphor"], "diagnostic_questions": ["What knowledge is embodied in the adaptation?", "What replication and selection process created it?", "Does the knowledge explain, or merely adapt to, its niche?"]}},
  "definitions": [],
  "claims": [{"id": "claim.evolution.adaptations-knowledge.v1", "summary": "Biological adaptations and human ideas both embody knowledge created through variation and selection, but human knowledge can be explanatory and achieve reach that adaptations generally cannot.", "kind": "explanatory-theory", "scope": "domain-bounded", "transfer_policy": "bridge-required", "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.boi.2011.allen-lane", "locator": "chapter 4 summary, lines 982-987", "verification": "checked"}], "lineage": "claim.evolution.adaptations-knowledge", "version": 1, "lifecycle": "active"}],
  "arguments": [{"id": "argument.evolution.hard-to-vary-design.v1", "stance": "for", "summary": "Purpose-specific, hard-to-vary adaptation cannot be explained by chance alone; evolutionary replication and selection create the relevant knowledge without foresight.", "conclusions": ["claim.evolution.adaptations-knowledge.v1"], "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.boi.2011.allen-lane", "locator": "chapter 4, Creation, lines 744-982", "verification": "checked"}]}],
  "examples": [],
  "criticisms": [{"id": "criticism.evolution.not-optimizer.v1", "stance": "qualifies", "summary": "Evolution does not optimize the welfare of a species, group, organism, or gene; claims of optimization require a specified replication dynamic and should not be imported into organizations by metaphor.", "conclusions": ["claim.evolution.adaptations-knowledge.v1"], "origin": {"representation": "editorial-synthesis", "represents": "skill-editor"}, "source_refs": []}],
