  "problem": {"id": "problem.reality.levels.v1", "summary": "Which explanatory entities and levels should be treated as real rather than dismissed as mere lower-level physics or arbitrary description?", "origin": {"representation": "editorial-synthesis", "represents": "skill-editor"}, "source_refs": [], "routing": {"reasoning_jobs": ["understand-worldview", "evaluate-explanation", "criticize"], "keywords": ["real", "reductionism", "holism", "emergence", "abstraction", "causation", "level"], "structural_predicates": ["A higher-level explanation is dismissed solely because lower-level components exist.", "A holistic description is treated as the only legitimate level."], "reject_if": ["ordinary database abstraction"], "diagnostic_questions": ["At what level does the autonomous explanatory pattern appear?", "What does the proposed entity do that kicks back against our expectations?"]}},
