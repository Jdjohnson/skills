  "claims": [{"id": "claim.explanations.no-single-hierarchy.v1", "summary": "Reductionism and holism are both inadequate as universal doctrines; explanations at emergent levels can be fundamental to the problems they solve, and abstractions can be real and causally relevant.", "kind": "explanatory-theory", "scope": "domain-bounded", "transfer_policy": "bridge-required", "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.boi.2011.allen-lane", "locator": "chapter 5 summary, lines 1136-1141", "verification": "checked"}], "lineage": "claim.explanations.no-single-hierarchy", "version": 1, "lifecycle": "active"}],
  "arguments": [{"id": "argument.fabric.includes-emergents.v1", "stance": "for", "summary": "Life, thought, and computation have autonomous explanatory facts and must be included in an integrated account of reality rather than treated as dispensable descriptions.", "conclusions": ["claim.explanations.no-single-hierarchy.v1"], "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.for.1997.penguin", "locator": "chapter 1 summary, lines 1007-1033", "verification": "checked"}]}],
