  "claims": [{"id": "claim.knowledge.conjecture-criticism.v1", "summary": "Theories originate as conjectures; knowledge grows when criticism and tests eliminate errors and better explanations replace inadequate ones.", "kind": "methodological-principle", "scope": "universal", "transfer_policy": "same-context", "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.for.1997.penguin", "locator": "chapter 3, Problem-solving, lines 1692-2205 and summary lines 2206-2234", "verification": "checked"}], "lineage": "claim.knowledge.conjecture-criticism", "version": 1, "lifecycle": "active"}],
