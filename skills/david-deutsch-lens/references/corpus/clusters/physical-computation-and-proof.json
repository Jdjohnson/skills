  "definitions": [],
  "claims": [{"id": "claim.computation.physical-principle.v1", "summary": "Deutsch treats computation as a physical process whose possible repertoire and efficiency depend on the laws of physics; he likewise treats proof as physically instantiated and mathematical knowledge as fallible.", "kind": "explanatory-theory", "scope": "domain-bounded", "transfer_policy": "non-transferable", "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.for.1997.penguin", "locator": "chapters 6, 9, and 10; chapter 10 summary, lines 7952-7972", "verification": "checked"}, {"source_id": "source.qc.1985.prs", "locator": "journal paper abstract and sections 1-2", "verification": "checked"}], "lineage": "claim.computation.physical-principle", "version": 1, "lifecycle": "active"}],
  "arguments": [{"id": "argument.computation.universal-simulator.v1", "stance": "for", "summary": "A physically possible universal simulator would reproduce every physically possible process in its domain, linking comprehensibility and computation to actual physical law rather than to syntax alone.", "conclusions": ["claim.computation.physical-principle.v1"], "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.for.1997.penguin", "locator": "chapter 6 summary, lines 4327-4342", "verification": "checked"}]}],
