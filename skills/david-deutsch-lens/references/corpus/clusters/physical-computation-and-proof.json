  "criticisms": [{"id": "criticism.computation.not-life-algorithm.v1", "stance": "qualifies", "summary": "Physical computation theory does not provide a career-choice algorithm, prove a management design, or make every mathematical theorem uncertain in the same sense.", "conclusions": ["claim.computation.physical-principle.v1"], "origin": {"representation": "editorial-synthesis", "represents": "skill-editor"}, "source_refs": []}, {"id": "criticism.computation.boi-errata-controls.v1", "stance": "qualifies", "summary": "Deutsch's official errata materially corrects the book's edition-sensitive discussion of Gödel, so analysis of those pages must use the correction rather than the uncorrected wording alone.", "conclusions": ["claim.computation.physical-principle.v1"], "origin": {"representation": "faithful-paraphrase", "represents": "david-deutsch"}, "source_refs": [{"source_id": "source.boi.errata.official", "locator": "correction for pages 184-185", "verification": "checked"}]}],
